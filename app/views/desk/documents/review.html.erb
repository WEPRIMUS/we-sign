<%= render 'desk/nav', current: :documents %>
<div class="flex flex-wrap items-start justify-between gap-4 mb-6">
  <div class="min-w-0">
    <h1 class="text-3xl font-bold break-words">Can I send it?</h1>
    <p class="mt-1 text-base-content/60"><%= @document.name %><%= " · #{@document.client.legal_name}" if @document.client %></p>
  </div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
  <div class="lg:col-span-3">
    <%= render 'desk/documents/pages', template: @template, with_boxes: true %>
  </div>
  <div class="lg:col-span-2 space-y-6">
    <section class="rounded-2xl bg-base-200 p-5">
      <h2 class="text-lg font-bold mb-3">Signers, in order</h2>
      <ol class="space-y-3 text-sm">
        <% @template.submitters.each_with_index do |party, index| %>
          <% submitter = @submission.submitters.find { |s| s.uuid == party['uuid'] } %>
          <li class="flex gap-3">
            <span class="mt-1 w-3 h-3 rounded-full shrink-0" style="background: <%= desk_party_color(index) %>"></span>
            <span>
              <b class="font-medium"><%= party['name'] %></b><br>
              <% if submitter && submitter == @own && @signs_now %>
                You sign for your company when you say Yes, with your saved signature.
              <% elsif submitter && submitter == @own && @own_slot.name.present? %>
                <%= @own_slot.name %> · <%= submitter.email %><br>
                <span class="text-base-content/60">The document names <%= @own_slot.name %> as the signer for <%= party['name'] %>. Only <%= @own_slot.name %> signs for it: when you say Yes, <%= @own_slot.name %> is asked to sign by e-mail first. Your signature is not used.</span>
              <% elsif submitter %>
                <%= submitter.name %> · <%= submitter.email %>
              <% else %>
                <span class="text-red-600">No e-mail address: this party was added in the editor.</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ol>
    </section>
    <% if @notes.any? %>
      <section class="rounded-2xl border border-base-300 p-5 text-sm">
        <h2 class="font-bold mb-2">Please check</h2>
        <ul class="list-disc ml-5 space-y-1"><% @notes.each do |note| %><li><%= note %></li><% end %></ul>
      </section>
    <% end %>
    <section class="rounded-2xl bg-base-200 p-5">
      <h2 class="text-lg font-bold mb-3">What the desk read</h2>
      <%= render 'desk/documents/facts', facts: @facts %>
    </section>
    <section class="rounded-2xl bg-base-200 p-5">
      <% if @blockers.any? %>
        <ul class="text-sm space-y-1 mb-4">
          <% @blockers.each do |blocker| %><li class="flex gap-2"><%= svg_icon('info_circle', class: 'w-5 h-5 shrink-0') %><%= blocker %></li><% end %>
        </ul>
      <% end %>
      <% recipients = @submission.submitters.reject { |s| s == @own && @signs_now }.map(&:email) %>
      <%= form_with url: approve_desk_document_path(@document), method: :post, class: 'space-y-3', data: { turbo_confirm: "Send it now to #{recipients.to_sentence}?" } do %>
        <% if @own && @signs_now && @template.fields.any? { |f| f['submitter_uuid'] == @own.uuid && f['name'] == 'Title' && f['default_value'].blank? } %>
          <label class="block text-sm">
            <span class="block font-medium mb-1">Your title on this document</span>
            <input name="signer_title" value="<%= desk_settings.signer_titles[current_user.id.to_s] %>" class="base-input w-full" placeholder="Manager">
          </label>
        <% end %>
        <%= tag.button('Yes, send', class: 'base-button w-full', type: 'submit', disabled: @blockers.any?) %>
      <% end %>
      <div class="flex gap-2 mt-3">
        <%= link_to 'Fix something', edit_template_path(@template), class: 'white-button flex-1' %>
        <%= button_to 'No', decline_desk_document_path(@document), class: 'btn btn-ghost w-full', form_class: 'flex-1', form: { data: { turbo_confirm: 'Do not send this document? It is archived, not deleted.' } } %>
      </div>
    </section>
  </div>
</div>
