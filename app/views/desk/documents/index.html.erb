<%= render 'desk/nav', current: :documents %>
<div class="flex items-center justify-between mb-4">
  <h1 class="text-3xl font-bold">Documents</h1>
  <%= link_to new_desk_upload_path, class: 'btn btn-primary gap-2' do %><%= svg_icon('cloud_upload', class: 'w-5 h-5') %><span>Upload a document</span><% end %>
</div>
<%= form_with url: desk_documents_path, method: :get, class: 'flex flex-wrap items-end gap-2 mb-5' do %>
  <select name="state" class="select select-bordered select-sm bg-white" aria-label="State">
    <option value="">All but archived</option>
    <% { 'waiting_for_you' => 'Waiting for you', 'preparing' => 'Preparing', 'ready_to_send' => 'Ready to send', 'out' => 'Out for signature', 'signed' => 'Signed', 'declined' => 'Declined', 'expired' => 'Expired', 'archived' => 'Archived' }.each do |value, label| %>
      <%= tag.option(label, value:, selected: params[:state] == value) %>
    <% end %>
  </select>
  <select name="client_id" class="select select-bordered select-sm bg-white" aria-label="Client">
    <option value="">Every client</option>
    <% @clients.each do |client| %>
      <%= tag.option(client.legal_name, value: client.id, selected: params[:client_id].to_s == client.id.to_s) %>
    <% end %>
  </select>
  <select name="doc_type" class="select select-bordered select-sm bg-white" aria-label="Type">
    <option value="">Every type</option>
    <% @doc_types.each do |type| %>
      <%= tag.option(desk_doc_type(type), value: type, selected: params[:doc_type] == type) %>
    <% end %>
  </select>
  <input type="search" name="q" value="<%= params[:q] %>" autocomplete="off" placeholder="Title, number or file name" class="input input-bordered input-sm bg-white w-64" aria-label="Search">
  <button type="submit" class="white-button btn-sm">Filter</button>
<% end %>
<% if @documents.empty? %>
  <p class="text-base-content/60">No documents<%= ' match these filters' if params.values_at(:state, :client_id, :doc_type, :q).any?(&:present?) %>.</p>
<% else %>
  <div class="overflow-x-auto rounded-xl border border-base-300 bg-white">
    <table class="table">
      <thead>
        <tr><th>Document</th><th>Client</th><th>Type</th><th>Number</th><th>State</th><th>Updated</th></tr>
      </thead>
      <tbody>
        <% @documents.each do |document| %>
          <tr class="hover">
            <td><%= link_to document.name, desk_document_path(document), class: 'font-medium hover:underline' %></td>
            <td><%= document.client ? link_to(document.client.legal_name, desk_client_path(document.client), class: 'hover:underline') : '' %></td>
            <td><%= desk_doc_type(document.doc_type) %></td>
            <td><%= desk_number(document) %></td>
            <td><%= desk_state_badge(document.state) %></td>
            <td class="whitespace-nowrap text-sm"><%= desk_time(document.updated_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %>
    <div class="flex items-center justify-between mt-4 text-sm">
      <span>Page <%= @pagy.page %> of <%= @pagy.pages %> · <%= @pagy.count %> documents</span>
      <span class="flex gap-2">
        <%= link_to 'Previous', url_for(params: request.query_parameters.merge('page' => @pagy.previous)), class: 'white-button btn-sm' if @pagy.previous %>
        <%= link_to 'Next', url_for(params: request.query_parameters.merge('page' => @pagy.next)), class: 'white-button btn-sm' if @pagy.next %>
      </span>
    </div>
  <% end %>
<% end %>
