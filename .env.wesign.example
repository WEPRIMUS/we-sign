# WE Sign (DocuSeal base) local trial. Copy to .env.wesign.local and replace every __NAME__. Never commit the copy.

# Application secret: signs sessions and derives the database-encryption key and the redis password. 128 hex characters (openssl rand -hex 64).
SECRET_KEY_BASE=__SECRET_KEY_BASE__
# Password of the PostgreSQL superuser "postgres"; the application never uses it (openssl rand -hex 24).
WESIGN_DB_SUPERUSER_PASSWORD=__WESIGN_DB_SUPERUSER_PASSWORD__
# Password of the application role "wesign_app"; must differ from the superuser's; letters and digits only, it goes into a URL (openssl rand -hex 24).
WESIGN_DB_APP_PASSWORD=__WESIGN_DB_APP_PASSWORD__
# Public address of the app; every link in an e-mail is built from it.
APP_URL=https://127.0.0.1:3141
# Sender name and address on every outgoing e-mail.
SMTP_FROM=WE Sign <wesign@example.com>
# Brand pack of this installation: the name of a folder under brands/ (logo, icons, colours, font, names). Default "we-primus".
# An unknown name stops the application at start.
BRAND=we-primus
# Product name shown to users: page titles, headers, e-mails, the audit PDF. Default "WE Sign".
PRODUCT_NAME=WE Sign
# Where the source code of the running version is offered (AGPL section 13); linked next to the attribution line.
SOURCE_CODE_URL=https://github.com/WEPRIMUS/we-sign
# Support address shown to staff and in upstream texts that name one, and the sender address when no SMTP sender is configured.
SUPPORT_EMAIL=support@example.com
