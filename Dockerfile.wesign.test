# WE Sign (DocuSeal base) - test image for the upstream RSpec suite.
# Same base image and packages as upstream CI (.github/workflows/ci.yml, job "rspec"),
# with the PDF engine pinned and checksum-verified exactly as in the main Dockerfile.
FROM ruby:4.0.5-alpine

ENV RAILS_ENV=test
ENV NODE_ENV=test
ENV BUNDLE_FROZEN="true"

RUN apk add --no-cache build-base git libpq-dev yaml-dev nodejs yarn tzdata unzip vips leptonica chromium && \
    wget -O /tmp/pdfium-linux.zip "https://github.com/docusealco/pdfium-binaries/releases/download/20260920/pdfium-musl-$(uname -m).zip" && \
    case "$(uname -m)" in \
      x86_64)  echo "bbca8a648dbd1ba81f9c6c223f21dc394cf1ad381c6c17d60c6dcc4a7d3a2ae0  /tmp/pdfium-linux.zip" ;; \
      aarch64) echo "73b72ed79b9bfdd494dee7e863482c24971a8d4b11f6cd1289aa170d31304a1f  /tmp/pdfium-linux.zip" ;; \
    esac | sha256sum -c - && \
    unzip -q /tmp/pdfium-linux.zip -d /tmp/pdfium-linux && \
    cp /tmp/pdfium-linux/lib/libpdfium.so /usr/lib/libpdfium.so && \
    rm -rf /tmp/pdfium-linux.zip /tmp/pdfium-linux

WORKDIR /app

COPY ./Gemfile ./Gemfile.lock ./
RUN bundle install --jobs 4 --retry 4

# The offline field finder (Templates::DetectFields), as in the main Dockerfile: the system onnxruntime in place of the
# gem's glibc build, and the same model, checked by SHA-256. The Contract Desk specs run it on real pages.
RUN apk add --no-cache onnxruntime && \
    ln -sf /usr/lib/libonnxruntime.so.1 $(ruby -e "print Dir[Gem::Specification.find_by_name('onnxruntime').gem_dir + '/vendor/*.so'].first") && \
    mkdir -p /app/tmp && \
    wget -O /app/tmp/model.onnx "https://github.com/docusealco/fields-detection/releases/download/2.0.0/model_704_int8.onnx" && \
    echo "a0a92ef7f50b6e5c707b7da9c59977bc7c9e9d8f85542bd75169c693f5efa4da  /app/tmp/model.onnx" | sha256sum -c -

COPY ./package.json ./yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 1000000

# Compile the JavaScript/CSS bundles from the same inputs as the webpack stage of the main Dockerfile.
# The ruby one-liner is what "rake shakapacker:compile" runs, without booting the Rails application, so
# this layer is rebuilt only when JavaScript, views or packages change, not on every Ruby or spec edit.
COPY ./bin/shakapacker ./bin/shakapacker
COPY ./config/webpack ./config/webpack
COPY ./config/shakapacker.yml ./config/shakapacker.yml
COPY ./postcss.config.js ./tailwind.config.js ./tailwind.form.config.js ./tailwind.dynamic.config.js ./tailwind.application.config.js ./
COPY ./app/javascript ./app/javascript
COPY ./app/views ./app/views
RUN bundle exec ruby -rrails -raction_controller -rshakapacker -e 'exit Shakapacker.compile'

COPY . .

# Create or update the test schema before every command, as upstream CI does before rspec. Without it, the
# first run against an empty database boots the models with no tables and five request specs fail.
ENTRYPOINT ["sh", "-c", "bin/rails db:prepare && exec \"$@\"", "--"]
CMD ["bundle", "exec", "rspec"]
